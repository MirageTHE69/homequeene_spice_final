# Database — SQLite for local development. For production switch the provider in
# prisma/schema.prisma to "postgresql" and point this at your Postgres URL.
DATABASE_URL="file:./dev.db"

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Public site URL (used in emails / metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Razorpay (optional). Leave empty to run Cash-on-Delivery only.
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
